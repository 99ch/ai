      "id": "1f55b0cc-8a00-4f75-b8fb-8d764813e66c",
      "name": "Fetch All CVs"
    },
    {
      "parameters": {
        "jsCode": "function normalizeList(value) {\n  if (Array.isArray(value)) {\n    return value.map(v => String(v).trim()).filter(Boolean);\n  }\n  if (!value) {\n    return [];\n  }\n  return String(value)\n    .replace(/<[^>]*>/g, ' ')\n    .split(/[,;\\n]+/)\n    .map(v => v.trim())\n    .filter(Boolean);\n}\n\nconst jobRaw = $json;\nconst cvs = Array.isArray(jobRaw.cvs) ? jobRaw.cvs : [];\nconst job = {\n  id: jobRaw.id,\n  title: jobRaw.title,\n  description: jobRaw.content || jobRaw.description || '',\n  excerpt: jobRaw.excerpt || '',\n  keywords: normalizeList(jobRaw.keywords),\n  location: jobRaw.location || '',\n  meta: jobRaw.meta || {},\n};\n\nconst items = cvs.map(cv => ({ json: { job, cv } }));\nreturn items;\n"
      },
