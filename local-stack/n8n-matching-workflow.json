    {
      "parameters": {
        "jsCode": "const apiKey = 'lN)KaQ22wfBd^mk[;ooh#zhWm6FA@ZOxhO!b&3tk*vM@jtLwjFyLT:tEIU9)Eu[2';\nconst cvsBaseUrl = 'http://172.20.10.2:8080/wp-json/keoni/v1/cvs';\nconst jobBaseUrl = 'http://172.20.10.2:8080/wp-json/keoni/v1/job';\nconst chunkSize = 200;\nconst limit = 100;\nlet offset = 0;\nconst all = [];\n\nconst jobPostId = $json?.body?.job_post_id;\nif (!jobPostId) {\n  throw new Error('Missing job_post_id in webhook payload');\n}\n\nconst headers = { 'X-API-Key': apiKey };\nconst job = await this.helpers.httpRequest({\n  method: 'GET',\n  url: `${jobBaseUrl}/${jobPostId}`,\n  headers,\n});\n\nwhile (true) {\n  const response = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `${cvsBaseUrl}?offset=${offset}&limit=${limit}`,\n    headers,\n  });\n\n  const items = Array.isArray(response.items) ? response.items : [];\n  all.push(...items);\n\n  if (items.length < limit) {\n    break;\n  }\n\n  offset += limit;\n}\n\nif (!all.length) {\n  return [{ json: { ...job, cvs: [] } }];\n}\n\nconst chunks = [];\nfor (let i = 0; i < all.length; i += chunkSize) {\n  const copy = JSON.parse(JSON.stringify(job));\n  copy.cvs = all.slice(i, i + chunkSize);\n  chunks.push({ json: copy });\n}\n\nreturn chunks;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
