# Production environment template. Copy to .env.prod on the server.
MATCHING_API_IMAGE=ghcr.io/your-org/keoni-matching-api
IMAGE_TAG=stable

POSTGRES_USER=keoni
POSTGRES_PASSWORD=__SET_STRONG_PASSWORD__
POSTGRES_DB=keoni_prod
POSTGRES_PORT=5432

MATCHING_API_KEY=__SET_RANDOM_64_CHARS__
WP_API_KEY=__SET_SAME_KEY_AS_KEONI_BRIDGE__

# Internal service URLs used by n8n workflow
MATCHING_API_BASE_URL=http://matching-api:8000
WP_API_BASE_URL=https://wp.example.com

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=__SET_STRONG_PASSWORD__
N8N_ENCRYPTION_KEY=__SET_RANDOM_32_BYTES_HEX__
N8N_WEBHOOK_SECRET=__SET_RANDOM_64_CHARS__
N8N_WEBHOOK_URL=https://n8n.example.com

# Optional API tuning
MATCHING_PRELOAD_MODEL=1
MATCHING_TOP_K=200
MATCHING_MIN_SIMILARITY=0.2
MATCHING_KEYWORD_WEIGHT=5
MATCHING_TITLE_WEIGHT=10
MATCHING_LOCATION_WEIGHT=5
MATCHING_CATEGORY_WEIGHT=6
MATCHING_JOBTYPE_WEIGHT=8
MATCHING_EXPERIENCE_WEIGHT=8
MATCHING_SALARY_WEIGHT=6
MATCHING_QUALIFICATION_PENALTY=20
MATCHING_HARD_FILTER_JOBTYPE=1
MATCHING_HARD_FILTER_QUALIFICATION=1
EMBED_BATCH_SIZE=32
TIMEZONE=Europe/Paris
